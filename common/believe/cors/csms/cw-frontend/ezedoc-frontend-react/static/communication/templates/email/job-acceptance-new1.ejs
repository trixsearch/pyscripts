<!DOCTYPE html>

<html lang="en" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml">

<head>
  <title></title>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <!--[if mso]><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch><o:AllowPNG/></o:OfficeDocumentSettings></xml><![endif]-->
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
    }

    th.column {
      padding: 0
    }

    a[x-apple-data-detectors] {
      color: inherit !important;
      text-decoration: inherit !important;
    }

    #MessageViewBody a {
      color: inherit;
      text-decoration: none;
    }

    p {
      line-height: inherit
    }

    @media (max-width:520px) {
      .icons-inner {
        text-align: center;
      }

      .icons-inner td {
        margin: 0 auto;
      }

      .row-content {
        width: 100% !important;
      }

      .stack .column {
        width: 100%;
        display: block;
      }
    }
  </style>
</head>

<body style="background-color: #FFFFFF; margin: 0; padding: 0; -webkit-text-size-adjust: none; text-size-adjust: none;">
  <table border="0" cellpadding="0" cellspacing="0" class="nl-container" role="presentation"
    style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; background-color: #F8F9FC; padding: 20px;" width="100%">
    <tbody>
      <tr>
        <td>
          
          <table align="center" border="0" cellpadding="0" cellspacing="0" class="row row-2" role="presentation"
            style="mso-table-lspace: 0pt; mso-table-rspace: 0pt;" width="100%">
            <tbody>
              <tr>
                <td>
                  <table align="center" border="1" cellpadding="0" cellspacing="0" class="row-content stack"
                    role="presentation"
                    style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; background-color: #FFFFFF; border:1px solid #D9DBDE; border-radius: 8px; color: #000000;"
                    width="650">
                    <tbody>
                      <tr>
                        <th class="column"
                          style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; font-weight: 400; text-align: left; vertical-align: top; padding-right: 20px; padding-left: 20px; padding-top: 10px; padding-bottom: 10px; border-top: 0px; border-right: 0px; border-bottom: 0px; border-left: 0px;"
                          width="100%">

                          <table border="0" cellpadding="0" cellspacing="0" class="image_block" role="presentation"
                          style="mso-table-lspace: 0pt; mso-table-rspace: 0pt;" width="100%">
                          <tr>
                            <td style="width:100%;padding-right:0px;padding-left:0px;">
                              <div align="center" style="line-height:10px"><img src="<%= assetsBaseURL %>/hire/images/user-placeholder.png"
                                  style="display: block; height: 24px; width: 24px; border: 0;  max-width: 100%;"
                                  width="48" /></div>
                            </td>
                          </tr>
                        </table>
                        <table border="0" cellpadding="10" cellspacing="0" class="text_block" role="presentation"
                          style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; word-break: break-word;" width="100%">
                          <tr>
                            <td>
                              <div>
                                <div
                                  style="font-size: 18px; mso-line-height-alt: 16.8px; color: #050F24; line-height: 24px;">
                                  <p style="margin: 0; font-family: Inter, Arial, Helvetica Neue, Helvetica, sans-serif; font-style: normal; font-weight: 600; font-size: 18px; line-height: 24px; text-align: center;color: #050F24; opacity: 0.8"><span
                                      style="color:#050F24;font-size:18px;"><strong><%= vendorName %></strong></span></p>
                                </div>
                              </div>
                            </td>
                          </tr>
                        </table>
                        <table border="0" cellpadding="10" cellspacing="0" class="text_block" role="presentation"
                            style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; word-break: break-word;" width="100%">
                            <tr>
                              <td>
                                <div>
                                  <div
                                    style="font-family: Inter, Arial, Helvetica Neue, Helvetica, sans-serif; font-style: normal; font-weight: 700; font-size: 18px; line-height: 24px; color: #050F24; opacity: 0.8; mso-line-height-alt: 16.8px; border: 1px solid #D9DBDE; border-left:0; border-right:0; padding:24px 0; ">
                                    <p style="margin: 0; text-align: center;"><%= vendorOrgName %> accepted assigned job
                                    </p>
                                  </div>
                                </div>
                              </td>
                            </tr>
                          </table>

                          <table border="0" cellpadding="10" cellspacing="0" class="text_block" role="presentation"
                            style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; word-break: break-word;" width="100%">
                            <tr>
                              <td>
                                <div>
                                  <div
                                    style="font-family: Inter, Arial, Helvetica Neue, Helvetica, sans-serif; font-style: normal; font-size: 14px; font-weight: 600; line-height: 20px; color: #050F24; opacity: 0.8; mso-line-height-alt: 16.8px;">
                                    <p style="margin: 0; font-size: 14px; line-height: 20px; text-align: center;"><span
                                       style="color: #050F24;">Dear <%= employerManager %>,</span></p>
                                  </div>
                                </div>
                              </td>
                            </tr>
                          </table>
                          <table border="0" cellpadding="10" cellspacing="0" class="text_block" role="presentation"
                            style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; word-break: break-word;" width="100%">
                            <tr>
                              <td>
                                <div>
                                  <div
                                    style="font-family: Inter, Arial, Helvetica Neue, Helvetica, sans-serif; font-style: normal; font-size: 14px; line-height: 20px; mso-line-height-alt: 16.8px; color: #050F24;">
                                    <p style="margin-top: 0; font-size: 14px; opacity: 0.8; line-height: 20px; text-align: center;"><strong><%= vendorUserName %></strong> from vendor - <strong><%= vendorOrgName %></strong> has accepted assigned job <strong>( <%= jobName %>/<%= jobRole %>/<%= city %>/<%= openings %> )</strong></p>
                                    <center><a
                                        href="<%= redirectUrl %>"
                                        style="font-size: 12px;
                                          display: flex;
                                          flex-direction: row;
                                          justify-content: center;
                                          align-items: center;
                                          gap: 10px;
                                          font-weight: 600;
                                          padding: 13px 40px;
                                          line-height: 16px;
                                          background-color: #1B2D93;
                                          color: #FFF;
                                          border-radius: 8px;
                                          text-decoration-line: none;
                                          display: inline-block;
                                          width: fit-content;"
                                        role="button"
                                        target="_blank"
                                      >
                                      Track Progress
                                      </a></center>  
                                </div>
                                </div>
                              </td>
                            </tr>
                          </table>

                          <table border="0" cellpadding="5" cellspacing="0" class="text_block" role="presentation"
                          style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; word-break: break-word;" width="100%">
                          <tr>
                            <td>
                              <div>
                                <div
                                  style="font-size: 12px; font-weight: 400; mso-line-height-alt: 16.8px; color: #828792; line-height: 18px; font-family: Inter, Arial, Helvetica Neue, Helvetica, sans-serif; padding-top:20px;">
                                  <p style="margin: 0; font-size: 12px; text-align: right;"><span
                                      style="font-size: 12px;">Powered by betterplace</span></p>
                                </div>
                              </div>
                            </td>
                          </tr>
                        </table>

                        </th>
                      </tr>
                    </tbody>
                  </table>
                </td>
              </tr>
            </tbody>
          </table>
          
        </td>
      </tr>
    </tbody>
  </table><!-- End -->
</body>

</html>
