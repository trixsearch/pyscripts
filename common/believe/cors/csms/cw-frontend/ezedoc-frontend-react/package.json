  "scripts": {
    "start": "webpack serve",
    "start-test": "BROWSER=none NODE_ENV=test react-scripts -r @cypress/instrument-cra start",
    "build:sit-ril": "npm install -g cross-env && cross-env ENV=sit-ril webpack --mode production && cp -R ./public/* ./dist",
    "build:sit-ril-intra": "npm install -g cross-env && cross-env ENV=sit-ril-intra webpack --mode production && cp -R ./public/* ./dist",
    "build:ril": "npm install -g cross-env && cross-env ENV=ril webpack --mode production && cp -R ./public/* ./dist",
    "build:ril-intra": "npm install -g cross-env && cross-env ENV=ril-intra webpack --mode production && cp -R ./public/* ./dist",
    "build": "concurrently yarn:build:webpack && cp -R ./public/* ./dist",
    "test": "cross-env BABEL_ENV=test jest",
    "eslint": "eslint",
    "cypress": "cypress",
    "test-cy": "cypress open",
    "test-cy-cli": "cypress run --headless --browser chrome",
    "test-cy-report": "cypress run --headless --browser chrome --reporter mochawesome",
    "postbuild": "bash buildFinished.sh > /dev/null 2>&1",
    "analyze": "webpack --mode=production --env analyze",
    "start:standalone": "webpack serve --env standalone",
    "build:webpack": "webpack --mode=production",
    "lint": "eslint src --ext js",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "watch-tests": "cross-env BABEL_ENV=test jest --watch",
    "coverage": "cross-env BABEL_ENV=test jest --coverage"
  },
  "husky": {
    "hooks": {
